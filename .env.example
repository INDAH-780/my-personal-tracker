# Database (Vercel Postgres)
PRISMA_DATABASE_URL="postgresql://username:password@host:5432/database?pgbouncer=true&connect_timeout=15&sslmode=require"
POSTGRES_URL="postgresql://username:password@host:5432/database?sslmode=require"

# Vercel Blob
BLOB_READ_WRITE_TOKEN="vercel_blob_token"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Automated scholarship discovery
CRON_SECRET="replace-with-a-long-random-secret"
AUTOMATION_USER_EMAIL="your-account@example.com"
TAVILY_API_KEY="your-tavily-api-key"
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_EXTRACTION_MODEL="gemini-3.6-flash"
SCHOLARSHIP_APPLICANT_COUNTRY="Cameroon"
SCHOLARSHIP_SEARCH_MAX_QUERIES="20"
SCHOLARSHIP_SEARCH_RESULTS_PER_QUERY="12"
